# Anthropic (Claude Opus 5.5 + Haiku 5.5) -> https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Finnhub (news + insider trades) -> https://finnhub.io/register
FINNHUB_API_KEY=your-finnhub-key

# NewsAPI (optional backup) -> https://newsapi.org
NEWSAPI_KEY=your-newsapi-key

# SEC EDGAR requires a real email in the User-Agent, free
SEC_USER_AGENT=Your Name your-email@example.com

# Postgres (used by docker-compose)
POSTGRES_USER=finscout
POSTGRES_PASSWORD=changeme
POSTGRES_DB=finscout
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Model selection (can override to test cheaper models)
MODEL_REASONING=claude-opus-5-5
MODEL_FAST=claude-haiku-5-5

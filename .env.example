# ───────────────────────────────────────────────────────────────
# PICK YOUR LLM — this one switch controls the whole app
# Options: anthropic | ollama
# ───────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic

# ── Anthropic (Claude Opus 5.5 + Haiku 5.5) ──
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here
MODEL_REASONING=claude-opus-5-5
MODEL_FAST=claude-haiku-5-5

# ── Ollama (local, free, works offline) ──
# Install: https://ollama.com/download
# One-time: ollama pull qwen2.5:14b && ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REASONING_MODEL=qwen2.5:14b
OLLAMA_FAST_MODEL=llama3.2:3b

# ── Data sources (all free, no keys required) ──
# News + prices + financials + insider trades come from yfinance (Yahoo Finance).
# SEC EDGAR needs a real email in the User-Agent (free, no key).
SEC_USER_AGENT=Your Name your-email@example.com

# ── Postgres (used by docker-compose) ──
POSTGRES_USER=finscout
POSTGRES_PASSWORD=changeme
POSTGRES_DB=finscout
POSTGRES_HOST=db
POSTGRES_PORT=5432
